generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                String   @id @default(cuid())
  username          String   @unique
  email             String?  @unique
  displayName       String
  passwordHash      String
  bio               String?
  avatarUrl         String?
  city              String
  importedFollowers Int      @default(0) // cold-start signal, decays
  isTastemaker      Boolean  @default(false) // seeded curator with a trusted list
  publishedAt       DateTime? // reciprocity gate: set when their 10-place list goes live
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  interests           UserInterest[]
  posts               Post[]
  validations         Validation[]      @relation("Validator") // "I went here because of you, it delivered"
  receivedValidations Validation[]      @relation("ValidatedUser")
  credibilityScore    CredibilityScore?
  picks               Pick[]
}

model Interest {
  id       String @id @default(cuid())
  slug     String @unique
  label    String
  category String // "food", "movement", "culture", "lifestyle", "nightlife"
  emoji    String

  users UserInterest[]
  posts PostInterest[]
}

model UserInterest {
  userId     String
  interestId String
  strength   Float  @default(1.0) // grows with consistent behavior

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  interest Interest @relation(fields: [interestId], references: [id], onDelete: Cascade)

  @@id([userId, interestId])
}

model Place {
  id           String   @id @default(cuid())
  name         String
  category     String // pick categories: cafe, restaurant, bar, area, activity, shop (legacy values map via lib/taste.ts)
  address      String
  city         String
  neighborhood String? // e.g. "El Born", "Gràcia" — secondary overlap signal
  externalId   String? // OpenStreetMap id when added via places lookup
  lat          Float
  lng          Float
  coverImage   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  posts Post[]
  picks Pick[]
}

// One slot in a user's curated 10-place list. The list IS the product:
// stable, edited occasionally, no check-ins or activity.
model Pick {
  id        String   @id @default(cuid())
  userId    String
  placeId   String
  note      String? // one line: why they love it
  rank      Int // display order 1..10
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@unique([userId, placeId]) // a place appears once per list
}

model Post {
  id        String   @id @default(cuid())
  userId    String
  placeId   String?
  content   String
  imageUrl  String?
  postType  String // "checkin" | "list" | "moment"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  place       Place?         @relation(fields: [placeId], references: [id])
  interests   PostInterest[]
  validations Validation[]
}

model PostInterest {
  postId     String
  interestId String

  post     Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  interest Interest @relation(fields: [interestId], references: [id], onDelete: Cascade)

  @@id([postId, interestId])
}

model Validation {
  id              String   @id @default(cuid())
  validatorId     String // user who is validating
  validatedUserId String // user being validated
  postId          String // the post that led to the experience
  note            String? // optional "this was exactly right"
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  validator     User @relation("Validator", fields: [validatorId], references: [id], onDelete: Cascade)
  validatedUser User @relation("ValidatedUser", fields: [validatedUserId], references: [id], onDelete: Cascade)
  post          Post @relation(fields: [postId], references: [id], onDelete: Cascade)
}

model CredibilityScore {
  id                    String   @id @default(cuid())
  userId                String   @unique
  totalScore            Float    @default(0)
  tasteSignalStrength   Float    @default(0) // 0–100
  peerValidationDensity Float    @default(0) // 0–100
  consistencyBonus      Float    @default(0) // 0–20 bonus
  importedFollowerScore Float    @default(0) // cold-start, decays
  lastCalculated        DateTime @default(now())
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
